<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Vườn Chữ 2.0 — Đọc Truyện Tiếng Hàn & Trồng Cây PWA</title>
    <!-- PWA Manifest & Meta -->
    <meta name="theme-color" content="#121316">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="https://placehold.co/192x192/10b981/ffffff?text=VC">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Gowun+Batang:wght@400;700&family=Gowun+Dodum&family=Noto+Sans+KR:wght@300;400;500;700&family=Noto+Serif+KR:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        ui: ['"Be Vietnam Pro"', 'sans-serif'],
                        krSans: ['"Noto Sans KR"', 'sans-serif'],
                        krSerif: ['"Noto Serif KR"', 'serif'],
                        krBatang: ['"Gowun Batang"', 'serif'],
                        krDodum: ['"Gowun Dodum"', 'sans-serif'],
                    },
                },
            },
        };
    </script>

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
            overscroll-behavior-y: none;
        }

        /* Giao diện màu trang đọc */
        .theme-dark {
            --bg-app: #121316;
            --bg-surface: #1b1d22;
            --bg-elevated: #24272f;
            --border-subtle: #2e323c;
            --text-main: #e6e4df;
            --text-muted: #9ca3af;
            --accent: #34d399;
            --word-hover: rgba(52, 211, 153, 0.18);
            --word-active: rgba(52, 211, 153, 0.35);
            --word-saved: rgba(251, 191, 36, 0.18);
        }

        .theme-sepia {
            --bg-app: #f4ecd8;
            --bg-surface: #fbf6e9;
            --bg-elevated: #efe4ca;
            --border-subtle: #dfd2b5;
            --text-main: #3b3226;
            --text-muted: #786a56;
            --accent: #059669;
            --word-hover: rgba(5, 150, 105, 0.14);
            --word-active: rgba(5, 150, 105, 0.28);
            --word-saved: rgba(217, 119, 6, 0.18);
        }

        .theme-green {
            --bg-app: #e4efe7;
            --bg-surface: #eff6f1;
            --bg-elevated: #d6e6dc;
            --border-subtle: #bfd6c7;
            --text-main: #1f3328;
            --text-muted: #4f6b5b;
            --accent: #047857;
            --word-hover: rgba(4, 120, 87, 0.14);
            --word-active: rgba(4, 120, 87, 0.26);
            --word-saved: rgba(217, 119, 6, 0.18);
        }

        .theme-light {
            --bg-app: #f8fafc;
            --bg-surface: #ffffff;
            --bg-elevated: #f1f5f9;
            --border-subtle: #e2e8f0;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --accent: #10b981;
            --word-hover: rgba(16, 185, 129, 0.15);
            --word-active: rgba(16, 185, 129, 0.28);
            --word-saved: rgba(245, 158, 11, 0.15);
        }

        .app-bg { background-color: var(--bg-app); color: var(--text-main); }
        .surface-bg { background-color: var(--bg-surface); border-color: var(--border-subtle); }
        .elevated-bg { background-color: var(--bg-elevated); border-color: var(--border-subtle); }
        .subtle-border { border-color: var(--border-subtle); }
        .muted-text { color: var(--text-muted); }

        /* Từ tiếng Hàn tương tác */
        .kr-word {
            cursor: pointer;
            border-radius: 6px;
            padding: 1px 3px;
            margin: 0 -1px;
            transition: background-color 0.15s ease, transform 0.1s ease;
            display: inline;
        }
        .kr-word:hover { background-color: var(--word-hover); }
        .kr-word.active-word {
            background-color: var(--word-active);
            outline: 1.5px solid var(--accent);
        }
        .kr-word.looked-up { border-bottom: 1.5px dashed rgba(52, 211, 153, 0.6); }
        .kr-word.has-note { background-color: var(--word-saved); border-bottom: 2px solid #f59e0b; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.3); border-radius: 999px; }

        @keyframes plantSway {
            0%, 100% { transform: rotate(-1.5deg); }
            50% { transform: rotate(1.5deg); }
        }
        .plant-sway { transform-origin: bottom center; animation: plantSway 4s ease-in-out infinite; }
    </style>
</head>
<body class="theme-dark app-bg min-h-screen flex flex-col selection:bg-emerald-500/30 pb-20 sm:pb-0">

    <!-- TOP APP BAR -->
    <header class="sticky top-0 z-30 surface-bg border-b subtle-border backdrop-blur-md bg-opacity-95 px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-emerald-600 flex items-center justify-center text-white shrink-0 shadow-sm">
                <i data-lucide="sprout" class="w-4 h-4"></i>
            </div>
            <div class="min-w-0">
                <h1 id="headerStoryTitle" class="text-xs sm:text-sm font-bold truncate max-w-[160px] sm:max-w-xs">
                    Vườn Chữ 2.0
                </h1>
                <p class="text-[10px] muted-text truncate">PWA Đọc Truyện & Học Từ Vựng</p>
            </div>
        </div>

        <!-- Resources Pill & PWA Install Button -->
        <div class="flex items-center gap-2">
            <!-- PWA Install Button (ẩn nếu đã cài) -->
            <button id="installPwaBtn" onclick="installPWA()" class="hidden px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-xs font-semibold items-center gap-1 shadow-sm">
                <i data-lucide="download" class="w-3.5 h-3.5"></i> Cài App
            </button>

            <!-- Nước & Mặt trời -->
            <button onclick="switchTab('garden')" class="flex items-center gap-2 px-2.5 py-1 rounded-full elevated-bg border subtle-border text-xs font-semibold" title="Xem vườn cây">
                <span class="flex items-center gap-0.5 text-sky-400">💧 <span id="waterCount">0</span></span>
                <span class="opacity-30">|</span>
                <span class="flex items-center gap-0.5 text-amber-400">☀️ <span id="sunCount">0</span></span>
            </button>
        </div>
    </header>

    <!-- MAIN VIEWS CONTAINER (TAB-BASED SPA) -->
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 py-6 relative">

        <!-- ================= TAB 1: READ (ĐỌC TRUYỆN) ================= -->
        <section id="viewRead" class="space-y-6">
            <div class="pb-4 border-b subtle-border flex items-center justify-between gap-3">
                <div>
                    <span id="readCategoryBadge" class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-400 mb-1">
                        Truyện ngắn
                    </span>
                    <h2 id="articleMainTitle" class="text-xl sm:text-2xl font-bold font-krBatang leading-snug"></h2>
                </div>
                <div class="text-xs muted-text text-right shrink-0">
                    <div>📖 <strong id="readProgressText" class="text-emerald-400">0%</strong></div>
                    <div>🔖 <strong id="storyLookupCount">0</strong> từ đã tra</div>
                </div>
            </div>

            <!-- Nội dung tiếng Hàn -->
            <article id="readerContent" class="font-krBatang select-text break-keep pb-12 transition-all"></article>
        </section>

        <!-- ================= TAB 2: LIBRARY (THƯ VIỆN & TẢI FILE) ================= -->
        <section id="viewLibrary" class="hidden space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold">📚 Thư Viện Truyện & Tải Văn Bản</h2>
                    <p class="text-xs muted-text">Tải file .txt/.md hoặc dán văn bản tiếng Hàn mới</p>
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full elevated-bg"><span id="libraryStoryCount">0</span> truyện</span>
            </div>

            <!-- Form thêm truyện / Tải file -->
            <div class="p-4 rounded-2xl elevated-bg border subtle-border space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-emerald-400">+ Thêm bài đọc / truyện mới</span>
                    <label class="cursor-pointer px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition flex items-center gap-1.5">
                        <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Tải file .txt
                        <input type="file" id="storyFileInput" accept=".txt,.md" class="hidden" onchange="handleStoryFile(event)">
                    </label>
                </div>
                <input type="text" id="newStoryTitle" placeholder="Tiêu đề truyện (VD: 어린 왕자 - Chương 1)..." class="w-full px-3 py-2 rounded-xl surface-bg border subtle-border text-xs outline-none focus:border-emerald-500">
                <textarea id="newStoryContent" rows="4" placeholder="Dán văn bản tiếng Hàn vào đây..." class="w-full px-3 py-2 rounded-xl surface-bg border subtle-border text-xs font-krSans outline-none focus:border-emerald-500"></textarea>
                <div class="flex justify-end">
                    <button onclick="addNewStory()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition">
                        Lưu & Đọc ngay
                    </button>
                </div>
            </div>

            <!-- Danh sách truyện đã lưu -->
            <div id="storyListContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
        </section>

        <!-- ================= TAB 3: GARDEN (VƯỜN CÂY 6 LOÀI) ================= -->
        <section id="viewGarden" class="hidden space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold">🌱 Vườn Cây Tri Thức</h2>
                    <p class="text-xs muted-text">Đọc 5 phút = +1 💧 • Tra 10 từ = +1 ☀️</p>
                </div>
                <div class="flex items-center gap-2 text-xs font-bold">
                    <span class="px-2.5 py-1 rounded-full bg-sky-500/20 text-sky-400">💧 <span id="gardenWaterCount">0</span></span>
                    <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-400">☀️ <span id="gardenSunCount">0</span></span>
                </div>
            </div>

            <!-- Cây đang chăm sóc -->
            <div class="p-5 rounded-2xl elevated-bg border subtle-border grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
                <div class="flex flex-col items-center justify-center bg-gradient-to-b from-sky-950/20 to-emerald-950/30 rounded-2xl p-4 border subtle-border min-h-[220px] relative">
                    <span id="plantStageBadge" class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400">Giai đoạn 1/5</span>
                    <div id="plantIllustration" class="w-36 h-36 flex items-end justify-center plant-sway"></div>
                    <p id="plantStatusCaption" class="text-xs font-medium mt-2 text-center muted-text"></p>
                </div>

                <div class="space-y-4">
                    <div>
                        <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider" id="activePlantOrder">Cây #1 / 6</span>
                        <h3 id="activePlantName" class="text-xl font-bold mt-0.5">Hoa Anh Thảo</h3>
                        <p id="activePlantDesc" class="text-xs muted-text mt-1"></p>
                    </div>

                    <div class="space-y-3 text-xs">
                        <div>
                            <div class="flex justify-between font-semibold mb-1">
                                <span class="text-sky-400">💧 Nước tưới</span>
                                <span id="plantWaterText">0 / 5</span>
                            </div>
                            <div class="w-full h-2 rounded-full surface-bg overflow-hidden">
                                <div id="plantWaterBar" class="h-full bg-sky-400 transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between font-semibold mb-1">
                                <span class="text-amber-400">☀️ Hạt mặt trời</span>
                                <span id="plantSunText">0 / 10</span>
                            </div>
                            <div class="w-full h-2 rounded-full surface-bg overflow-hidden">
                                <div id="plantSunBar" class="h-full bg-amber-400 transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <button onclick="feedPlant('water')" id="btnWater" class="py-2 px-3 rounded-xl bg-sky-600 hover:bg-sky-500 disabled:opacity-40 text-white text-xs font-bold transition flex items-center justify-center gap-1">
                            💧 Tưới (<span id="availWater">0</span>)
                        </button>
                        <button onclick="feedPlant('sun')" id="btnSun" class="py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 disabled:opacity-40 text-gray-950 text-xs font-bold transition flex items-center justify-center gap-1">
                            ☀️ Bón nắng (<span id="availSun">0</span>)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bộ sưu tập 6 cây -->
            <div>
                <h3 class="text-xs font-bold muted-text uppercase tracking-wider mb-3">Bộ sưu tập 6 loài cây học tập</h3>
                <div id="plantCollectionGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5"></div>
            </div>
        </section>

        <!-- ================= TAB 4: MUSIC (TRÌNH PHÁT NHẠC CÁ NHÂN) ================= -->
        <section id="viewMusic" class="hidden space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold">🎵 Trình Phát Nhạc Cá Nhân</h2>
                    <p class="text-xs muted-text">Tải nhạc yêu thích (.mp3, .wav) để nghe khi đọc truyện</p>
                </div>
                <label class="cursor-pointer px-3 py-1.5 rounded-xl bg-pink-600 hover:bg-pink-500 text-white text-xs font-semibold transition flex items-center gap-1.5">
                    <i data-lucide="upload" class="w-3.5 h-3.5"></i> Thêm bài hát
                    <input type="file" id="audioFileInput" accept="audio/*" multiple class="hidden" onchange="handleAudioFiles(event)">
                </label>
            </div>

            <div class="p-6 rounded-2xl elevated-bg border subtle-border text-center space-y-4">
                <div class="w-16 h-16 mx-auto rounded-full bg-pink-500/20 text-pink-400 flex items-center justify-center text-2xl animate-pulse">
                    🎶
                </div>
                <div>
                    <h3 id="currentTrackDisplay" class="font-bold text-sm truncate">Chưa có bài nhạc nào</h3>
                    <p id="playlistInfo" class="text-xs muted-text mt-0.5">Danh sách phát trống</p>
                </div>

                <!-- Thanh tua nhạc -->
                <div class="space-y-1">
                    <div class="flex justify-between text-[11px] muted-text">
                        <span id="audioCurrentTime">0:00</span>
                        <span id="audioDuration">0:00</span>
                    </div>
                    <input type="range" id="audioSeekBar" min="0" max="100" value="0" oninput="seekAudio(this.value)" class="w-full accent-pink-500 cursor-pointer">
                </div>

                <!-- Điều khiển -->
                <div class="flex items-center justify-center gap-3 pt-2">
                    <button onclick="prevTrack()" class="p-2.5 rounded-xl surface-bg border subtle-border hover:opacity-80">⏮</button>
                    <button onclick="togglePlayPause()" id="mainPlayBtn" class="w-12 h-12 rounded-full bg-pink-600 hover:bg-pink-500 text-white flex items-center justify-center text-base shadow-lg">▶</button>
                    <button onclick="nextTrack()" class="p-2.5 rounded-xl surface-bg border subtle-border hover:opacity-80">⏭</button>
                    <button onclick="toggleLoop()" id="loopBtn" class="p-2.5 rounded-xl surface-bg border subtle-border opacity-50 hover:opacity-100" title="Lặp lại">🔁</button>
                </div>
            </div>

            <!-- Danh sách bài hát -->
            <div>
                <h3 class="text-xs font-bold muted-text uppercase tracking-wider mb-2">Danh sách bài hát</h3>
                <div id="playlistContainer" class="space-y-1.5 max-h-48 overflow-y-auto"></div>
            </div>
            <audio id="bgAudioPlayer"></audio>
        </section>

        <!-- ================= TAB 5: SETTINGS (CÀI ĐẶT & GIAO DIỆN) ================= -->
        <section id="viewSettings" class="hidden space-y-6">
            <div>
                <h2 class="text-lg font-bold">⚙️ Cài Đặt Giao Diện & Đọc Sách</h2>
                <p class="text-xs muted-text">Tùy chỉnh màu sắc, phông chữ và kích thước chữ đọc</p>
            </div>

            <div class="space-y-4 text-xs">
                <!-- Màu nền -->
                <div class="p-4 rounded-2xl elevated-bg border subtle-border space-y-2">
                    <label class="block font-semibold muted-text">Màu trang đọc</label>
                    <div class="grid grid-cols-4 gap-2">
                        <button onclick="setReaderTheme('dark')" class="py-2.5 rounded-xl bg-[#121316] text-gray-200 border border-gray-600 font-medium">Tối</button>
                        <button onclick="setReaderTheme('sepia')" class="py-2.5 rounded-xl bg-[#f4ecd8] text-[#3b3226] border border-[#d4c49e] font-medium">Giấy</button>
                        <button onclick="setReaderTheme('green')" class="py-2.5 rounded-xl bg-[#e4efe7] text-[#1f3328] border border-[#b4cebd] font-medium">Xanh</button>
                        <button onclick="setReaderTheme('light')" class="py-2.5 rounded-xl bg-white text-slate-800 border border-slate-300 font-medium">Sáng</button>
                    </div>
                </div>

                <!-- Phông chữ -->
                <div class="p-4 rounded-2xl elevated-bg border subtle-border space-y-2">
                    <label class="block font-semibold muted-text">Phông chữ tiếng Hàn</label>
                    <select id="fontSelect" onchange="updateTypography()" class="w-full px-3 py-2.5 rounded-xl surface-bg border subtle-border outline-none">
                        <option value="font-krBatang">Gowun Batang (Văn học mềm mại)</option>
                        <option value="font-krSerif">Noto Serif KR (Sách in cổ điển)</option>
                        <option value="font-krSans">Noto Sans KR (Hiện đại, rõ nét)</option>
                        <option value="font-krDodum">Gowun Dodum (Nhẹ nhàng, dễ đọc)</option>
                    </select>
                </div>

                <!-- Cỡ chữ & Giãn dòng -->
                <div class="p-4 rounded-2xl elevated-bg border subtle-border space-y-3">
                    <div>
                        <div class="flex justify-between font-semibold muted-text mb-1">
                            <span>Cỡ chữ</span>
                            <span id="fontSizeVal">21px</span>
                        </div>
                        <input type="range" id="fontSizeRange" min="16" max="32" step="1" value="21" oninput="updateTypography()" class="w-full accent-emerald-500 cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between font-semibold muted-text mb-1">
                            <span>Khoảng cách dòng</span>
                            <span id="lineHeightVal">2.0</span>
                        </div>
                        <input type="range" id="lineHeightRange" min="1.5" max="2.6" step="0.1" value="2.0" oninput="updateTypography()" class="w-full accent-emerald-500 cursor-pointer">
                    </div>
                </div>

                <!-- Quiz cài đặt -->
                <div class="p-4 rounded-2xl elevated-bg border subtle-border flex items-center justify-between">
                    <div>
                        <span class="font-semibold block">Kiểm tra nhanh từ vựng mỗi 5 phút</span>
                        <span class="text-[11px] muted-text">Nhận thêm Hạt mặt trời (☀️) khi trả lời đúng</span>
                    </div>
                    <input type="checkbox" id="quizToggle" checked onchange="toggleQuizSetting(this.checked)" class="w-4 h-4 accent-emerald-500 rounded">
                </div>
            </div>
        </section>
    </main>

    <!-- ================= BOTTOM NAVIGATION BAR (CHUẨN APP DI ĐỘNG) ================= -->
    <nav class="fixed bottom-0 left-0 right-0 z-30 surface-bg border-t subtle-border h-16 flex items-center justify-around px-2 shadow-2xl">
        <button onclick="switchTab('read')" id="navBtn-read" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl text-emerald-400 transition">
            <i data-lucide="book-open" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Đọc</span>
        </button>
        <button onclick="switchTab('library')" id="navBtn-library" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl muted-text hover:text-emerald-400 transition">
            <i data-lucide="library" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Thư viện</span>
        </button>
        <button onclick="switchTab('garden')" id="navBtn-garden" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl muted-text hover:text-emerald-400 transition relative">
            <i data-lucide="sprout" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Vườn cây</span>
            <span id="navGardenDot" class="hidden absolute top-1 right-2 w-2 h-2 rounded-full bg-emerald-400"></span>
        </button>
        <button onclick="switchTab('music')" id="navBtn-music" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl muted-text hover:text-emerald-400 transition">
            <i data-lucide="music" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Nhạc</span>
        </button>
        <button onclick="switchTab('settings')" id="navBtn-settings" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl muted-text hover:text-emerald-400 transition">
            <i data-lucide="sliders" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Cài đặt</span>
        </button>
    </nav>

