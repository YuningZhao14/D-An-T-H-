<!doctype html>
<html lang="vi" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#101510">
  <title>Vườn Chữ 2.0 — Đọc truyện Hàn</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Gowun+Batang:wght@400;700&family=Gowun+Dodum&family=Noto+Sans+KR:wght@300;400;500;700&family=Noto+Serif+KR:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{color-scheme:dark;--bg:#101510;--surface:#171e19;--card:#1d2720;--line:#2b382f;--text:#e7eee8;--muted:#9ba99e;--accent:#5bd39a;--accent-soft:#173d2b;--reader:#121914;--reader-text:#e7eee8;--shadow:0 16px 48px #0006}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px 'Be Vietnam Pro',sans-serif;min-height:100vh;padding-bottom:82px}button,input,textarea,select{font:inherit}button{cursor:pointer;color:inherit}button:disabled{opacity:.42;cursor:not-allowed}.shell{max-width:980px;margin:auto;padding:20px}.top{height:64px;position:sticky;top:0;z-index:10;background:#111813eF;border-bottom:1px solid var(--line);backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;padding:0 max(calc((100vw - 940px)/2),20px)}.brand{display:flex;align-items:center;gap:11px;min-width:0}.logo{width:37px;height:37px;border-radius:13px;background:#1a8051;display:grid;place-items:center;font-size:20px}.brand h1{font-size:14px;margin:0}.brand p{font-size:10px;color:var(--muted);margin:2px 0 0}.top-actions{display:flex;gap:8px;align-items:center}.resource{border:1px solid var(--line);background:var(--card);border-radius:24px;padding:8px 12px;font-size:12px;white-space:nowrap}.btn{border:1px solid var(--line);border-radius:11px;background:var(--card);padding:9px 12px;font-size:12px;font-weight:600;transition:.18s}.btn:hover{border-color:var(--accent);transform:translateY(-1px)}.primary{background:#188653;border-color:#188653;color:white}.pink{background:#aa437a;border-color:#aa437a;color:white}.muted{color:var(--muted)}.view{display:none}.view.active{display:block}.heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 0 22px}.heading h2{font-size:21px;margin:0}.heading p{font-size:12px;color:var(--muted);margin:5px 0 0}.reader-head{border-bottom:1px solid var(--line);padding:8px 0 16px;display:flex;justify-content:space-between;gap:12px}.reader-head h2{font:700 24px 'Gowun Batang',serif;margin:8px 0 0}.badge{display:inline-block;font-size:10px;color:#7ce4ac;background:#143522;border-radius:20px;padding:4px 9px}.stats{text-align:right;font-size:11px;color:var(--muted);white-space:nowrap}.stats strong{color:var(--accent)}#reader{margin:20px auto;background:var(--reader);color:var(--reader-text);border:1px solid var(--line);border-radius:18px;padding:clamp(20px,5vw,46px);max-width:790px;min-height:400px;font-family:'Gowun Batang',serif;font-size:21px;line-height:2;word-break:keep-all}.reader-paragraph{margin:0 0 1.4em;position:relative}.word{border-radius:5px;padding:1px 2px;cursor:pointer;transition:background .15s;border-bottom:1px dashed #45b98288}.word:hover,.word.selected{background:#26895c33}.word.has-note{background:#efb94a20;border-bottom:2px solid #e8b34f}.inline-card{font:12px 'Be Vietnam Pro',sans-serif;word-break:normal;line-height:1.55;background:var(--surface);color:var(--text);border:1px solid #398a60;border-radius:14px;padding:14px;margin:10px 0 16px;box-shadow:var(--shadow);max-width:440px;position:relative;z-index:2}.inline-top{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:9px}.inline-card h3{margin:0;font:700 19px 'Noto Sans KR',sans-serif;color:#75e3aa}.inline-card p{margin:4px 0}.inline-card .meaning{font-size:14px;font-weight:600}.inline-card .label{font-size:10px;color:var(--accent);font-weight:700}.inline-card .comment-box{display:flex;gap:6px;margin-top:10px}.field,textarea,select{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:10px 11px;color:var(--text);outline:none}.field:focus,textarea:focus,select:focus{border-color:var(--accent)}.inline-card .comment-box input{font-size:11px;padding:8px}.inline-card .comment-box button{padding:7px 10px}.inline-card .close-inline{font-size:12px;align-self:start;padding:5px 8px}.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:16px;margin:14px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.form-grid{display:grid;gap:10px}.story-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:15px;display:flex;flex-direction:column;gap:12px}.story-card h3{font-size:14px;margin:0;overflow-wrap:anywhere}.story-card p{font-size:11px;color:var(--muted);margin:5px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.row-wrap{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.label{font-size:11px;color:var(--muted);font-weight:600}.tabs{position:fixed;z-index:15;bottom:0;left:0;right:0;height:68px;background:#151d17f2;border-top:1px solid var(--line);backdrop-filter:blur(14px);display:flex;justify-content:center;gap:clamp(2px,4vw,36px);align-items:center;padding:0 8px}.tabs button{border:0;background:none;color:var(--muted);font-size:10px;padding:7px 10px;border-radius:10px}.tabs button.active{color:var(--accent);background:#21463166}.tabs span{display:block;font-size:17px;margin-bottom:3px}.plant{min-height:175px;border-radius:16px;background:linear-gradient(140deg,#183d32,#17251e);display:grid;place-items:center;font-size:80px}.progress{height:8px;border-radius:9px;background:#101510;overflow:hidden}.progress i{display:block;height:100%;background:#56c98a;border-radius:9px}.track{padding:10px;border-radius:10px;background:var(--card);display:flex;justify-content:space-between;gap:10px;align-items:center}.notice{position:fixed;right:16px;bottom:82px;z-index:30;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:11px 15px;box-shadow:var(--shadow);font-size:12px}.hidden{display:none!important}.small{font-size:11px}.range{width:100%;accent-color:#34c984}.read-progress{height:3px;background:#26352b}.read-progress i{height:100%;display:block;background:var(--accent);width:0}.theme-sepia{--reader:#f4ecd8;--reader-text:#3b3226}.theme-green{--reader:#e4efe7;--reader-text:#1f3328}.theme-light{--reader:#fff;--reader-text:#1e293b}.theme-dark{--reader:#121914;--reader-text:#e7eee8}
    @media(max-width:600px){.shell{padding:15px}.top{padding:0 12px}.brand p{display:none}.resource{padding:7px 9px}.heading h2{font-size:18px}.reader-head h2{font-size:21px}#reader{padding:20px 17px;border-radius:14px}.inline-card{width:min(100%,400px)}.tabs{gap:0;justify-content:space-around}.tabs button{padding:7px 6px}}
  </style>
</head>
<body class="theme-dark">
  <header class="top">
    <div class="brand"><div class="logo">🌱</div><div><h1>Vườn Chữ 2.0</h1><p>Đọc truyện Hàn · học từ · chăm cây</p></div></div>
    <div class="top-actions"><button class="resource" onclick="switchTab('garden')">💧 <b id="waterCount">0</b>　☀️ <b id="sunCount">0</b></button></div>
  </header>
  <div class="read-progress"><i id="progressBar"></i></div>
  <main class="shell">
    <section id="view-read" class="view active">
      <div class="reader-head"><div><span class="badge" id="category">Truyện ngắn</span><h2 id="storyTitle">Đang tải...</h2></div><div class="stats">Đã đọc <strong id="progressText">0%</strong><br><span id="lookupCount">0</span> từ đã tra</div></div>
      <article id="reader"></article>
      <div class="row muted small"><span>💡 Nhấn vào từ tiếng Hàn để xem giải thích ngay tại đoạn đang đọc.</span><button class="btn" onclick="switchTab('library')">＋ Thêm truyện</button></div>
    </section>

    <section id="view-library" class="view">
      <div class="heading"><div><h2>📚 Thư viện truyện</h2><p>Tải .txt/.md, dán văn bản hoặc mở truyện đã lưu.</p></div><span class="badge" id="storyCount">0 truyện</span></div>
      <div class="panel form-grid">
        <div class="row"><strong>Thêm bài đọc mới</strong><label class="btn primary">Tải file .txt/.md<input id="storyFile" type="file" accept=".txt,.md,text/plain,text/markdown" hidden></label></div>
        <input id="newTitle" class="field" placeholder="Tên truyện / chương">
        <textarea id="newContent" rows="6" placeholder="Dán văn bản tiếng Hàn vào đây..."></textarea>
        <div class="row"><span class="muted small">Truyện được lưu trên thiết bị này.</span><button class="btn primary" onclick="addStory()">Lưu truyện</button></div>
      </div>
      <div id="storyList" class="grid"></div>
    </section>

    <section id="view-garden" class="view">
      <div class="heading"><div><h2>🌿 Vườn cây tri thức</h2><p>Đọc 5 phút nhận 💧 · tra 10 từ nhận ☀️ · trả lời quiz đúng nhận ☀️</p></div><div class="row-wrap"><span class="badge">💧 <b id="gardenWater">0</b></span><span class="badge">☀️ <b id="gardenSun">0</b></span></div></div>
      <div class="grid">
        <div class="panel"><div class="plant" id="plantArt">🌱</div><h2 id="plantName">Hoa Anh Thảo</h2><p id="plantDesc" class="muted small"></p><div class="small row"><span>💧 Nước</span><b id="waterProgress">0 / 5</b></div><div class="progress"><i id="waterBar"></i></div><div class="small row" style="margin-top:12px"><span>☀️ Mặt trời</span><b id="sunProgress">0 / 10</b></div><div class="progress"><i id="sunBar"></i></div><div class="row-wrap" style="margin-top:14px"><button class="btn" id="feedWater" onclick="feed('water')">Tưới 💧</button><button class="btn" id="feedSun" onclick="feed('sun')">Bón nắng ☀️</button></div></div>
        <div><h3>6 loài cây</h3><div id="plantList" class="form-grid"></div></div>
      </div>
    </section>

    <section id="view-music" class="view">
      <div class="heading"><div><h2>🎵 Nhạc của bạn</h2><p>Chọn các tệp âm thanh từ thiết bị; nhạc không tải lên máy chủ.</p></div><label class="btn pink">＋ Thêm nhạc<input id="audioFiles" type="file" accept="audio/*" multiple hidden></label></div>
      <div class="panel" style="text-align:center"><div style="font-size:42px">🎧</div><h3 id="trackName">Chưa chọn bài nhạc</h3><p class="muted small" id="trackSummary">Danh sách phát trống</p><audio id="audio" controls style="width:100%;margin:12px 0"></audio><div class="row-wrap" style="justify-content:center"><button class="btn" onclick="playTrack(currentTrack-1)">⏮ Trước</button><button class="btn" onclick="toggleAudio()" id="playButton">▶ / ⏸</button><button class="btn" onclick="playTrack(currentTrack+1)">Tiếp ⏭</button><label class="small"><input id="loopAudio" type="checkbox"> Lặp bài</label></div></div>
      <div id="playlist" class="form-grid"></div>
    </section>

    <section id="view-settings" class="view">
      <div class="heading"><div><h2>⚙️ Cài đặt đọc</h2><p>Tùy chỉnh màu nền, font chữ và khoảng cách.</p></div></div>
      <div class="panel form-grid"><label class="label">Màu trang đọc</label><div class="row-wrap"><button class="btn" onclick="setTheme('dark')">🌑 Tối</button><button class="btn" onclick="setTheme('sepia')">📜 Giấy</button><button class="btn" onclick="setTheme('green')">🌿 Xanh</button><button class="btn" onclick="setTheme('light')">☀️ Sáng</button></div>
        <label class="label" for="fontSelect">Phông chữ tiếng Hàn</label><select id="fontSelect" onchange="updateTypography()"><option value="Gowun Batang">Gowun Batang</option><option value="Noto Serif KR">Noto Serif KR</option><option value="Noto Sans KR">Noto Sans KR</option><option value="Gowun Dodum">Gowun Dodum</option></select>
        <label class="label">Cỡ chữ: <b id="fontSizeLabel">21px</b></label><input id="fontSize" class="range" type="range" min="16" max="34" value="21" oninput="updateTypography()">
        <label class="label">Khoảng cách dòng: <b id="lineHeightLabel">2.0</b></label><input id="lineHeight" class="range" type="range" min="1.5" max="2.8" step="0.1" value="2" oninput="updateTypography()">
        <div class="row"><div><b>Kiểm tra từ vựng mỗi 5 phút</b><div class="muted small">Đúng +1 ☀️ · sai trừ 1 phút đọc</div></div><input id="quizEnabled" type="checkbox" checked onchange="saveSetting('quizEnabled',this.checked)"></div>
        <hr style="border:0;border-top:1px solid var(--line);width:100%"><div><b>Giải thích AI (tùy chọn)</b><p class="muted small">Có thể nhập khóa Gemini để nhận giải thích theo ngữ cảnh. Khóa chỉ giữ trong bộ nhớ phiên hiện tại, không lưu vào thư viện.</p><input id="apiKey" class="field" type="password" autocomplete="off" placeholder="Gemini API key (không bắt buộc)"></div>
      </div>
    </section>
  </main>

  <nav class="tabs"><button id="tab-read" class="active" onclick="switchTab('read')"><span>📖</span>Đọc</button><button id="tab-library" onclick="switchTab('library')"><span>📚</span>Thư viện</button><button id="tab-garden" onclick="switchTab('garden')"><span>🌱</span>Vườn cây</button><button id="tab-music" onclick="switchTab('music')"><span>🎵</span>Nhạc</button><button id="tab-settings" onclick="switchTab('settings')"><span>⚙️</span>Cài đặt</button></nav>
  <div id="toast" class="notice hidden" role="status"></div>
  <div id="quiz" class="hidden" style="position:fixed;inset:0;z-index:25;background:#000b;display:grid;place-items:center;padding:16px"><div class="panel" style="width:min(440px,100%);box-shadow:var(--shadow)"><div class="row"><b>⚡ Kiểm tra từ vựng</b><button class="btn" onclick="closeQuiz()">✕</button></div><p id="quizPrompt" class="muted"></p><div id="quizOptions" class="form-grid"></div><p id="quizFeedback"></p><button id="quizDone" class="btn primary hidden" onclick="closeQuiz()">Tiếp tục đọc</button></div></div>

<script>
  const plants=[
    {name:'Hoa Anh Thảo',emoji:'🌼',water:5,desc:'Khởi đầu kiên nhẫn, nở trong chiều tà.'},
    {name:'Hoa Hồng Nhung',emoji:'🌹',water:10,desc:'Đóa hồng rực rỡ cần chăm chút mỗi ngày.'},
    {name:'Cỏ Bốn Lá',emoji:'🍀',water:15,desc:'Một chút may mắn trên hành trình từ vựng.'},
    {name:'Cây Hoa Anh Đào',emoji:'🌸',water:20,desc:'Tán hoa phấn hồng nở rộ mùa xuân.'},
    {name:'Cây Ngô Đồng',emoji:'🌳',water:25,desc:'Cây cao quý, vững vàng qua năm tháng.'},
    {name:'Cổ Thụ Ánh Sao',emoji:'✨',water:30,desc:'Cổ thụ huyền thoại của khu vườn tri thức.'}
  ];
  const samples=[
    {id:'sample-rain',title:'소나기 — Cơn mưa rào đầu hạ',category:'Truyện ngắn',content:'소년은 개울가에서 소녀를 보자 곧 윤 초시네 증손녀딸이라는 걸 알 수 있었다.\n\n소녀는 개울에다 손을 잠그고 물장난을 하고 있는 것이다.\n\n벌써 며칠째 소녀는 학교에서 돌아오는 길에 개울가에서 물장난을 하고 있었다. 소년은 개울둑에 앉아 버렸다. 소녀가 비켜서기를 기다리자는 것이다.'},
    {id:'sample-cat',title:'밤하늘의 별을 세는 고양이',category:'Cổ tích',content:'작은 마을의 가장 높은 지붕 위에는 매일 밤 올라가는 하얀 고양이가 있었습니다.\n\n고양이는 반짝이는 별들을 하나씩 세면서 자신의 소원을 빌었습니다. 어느 날, 작은 반딧불이 한 마리가 고양이의 코끝에 앉았습니다.'}
  ];
  const key='vuon-chu-v2-state';
  let state={stories:samples,currentId:samples[0].id,vocab:{},settings:{theme:'dark',font:'Gowun Batang',size:21,line:2,quiz:true},garden:{water:0,sun:0,seconds:0,lookups:0,active:0,progress:plants.map((_,i)=>({unlocked:i===0,water:0,sun:0,done:false}))}};
  let currentWord='',currentSentence='',currentParagraph=null,lookupCount=0,tracks=[],currentTrack=-1,timer=null;
  function load(){try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(saved){state={...state,...saved,settings:{...state.settings,...saved.settings},garden:{...state.garden,...saved.garden}};state.garden.progress=plants.map((_,i)=>({...({unlocked:i===0,water:0,sun:0,done:false}),...(state.garden.progress?.[i]||{})}));}}catch{} if(!state.stories.length)state.stories=samples; if(!state.stories.some(s=>s.id===state.currentId))state.currentId=state.stories[0].id;}
  function save(){try{localStorage.setItem(key,JSON.stringify(state));}catch{toast('Không đủ dung lượng lưu trữ. Hãy thử truyện ngắn hơn hoặc xóa bớt truyện.');}}
  function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.remove('hidden');clearTimeout(timer);timer=setTimeout(()=>el.classList.add('hidden'),2800);}
  function switchTab(id){document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));document.getElementById('view-'+id).classList.add('active');document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('active',b.id==='tab-'+id));if(id==='library')renderLibrary();if(id==='garden')renderGarden();window.scrollTo({top:0,behavior:'smooth'});}
  function currentStory(){return state.stories.find(s=>s.id===state.currentId)||state.stories[0];}
  function renderReader(){const story=currentStory();if(!story)return;document.getElementById('storyTitle').textContent=story.title;document.getElementById('category').textContent=story.category||'Bài đọc';const reader=document.getElementById('reader');reader.replaceChildren();lookupCount=0;
    story.content.split(/\n+/).forEach(line=>{if(!line.trim())return;const p=document.createElement('p');p.className='reader-paragraph';line.split(/(\s+)/u).forEach(token=>{if(!token.trim()){p.append(document.createTextNode(token));return;}if(!/[\uAC00-\uD7A3\u1100-\u11FF\u3130-\u318F]/u.test(token)){p.append(document.createTextNode(token));return;}const m=token.match(/^([^\uAC00-\uD7A3\u1100-\u11FF\u3130-\u318F]*)([\uAC00-\uD7A3\u1100-\u11FF\u3130-\u318F][^\s.,!?;:()\[\]{}“”‘’"']*)([^\uAC00-\uD7A3\u1100-\u11FF\u3130-\u318F]*)$/u);if(!m){p.append(document.createTextNode(token));return;}p.append(document.createTextNode(m[1]));const w=document.createElement('span');w.className='word';w.textContent=m[2];w.dataset.word=m[2];if(state.vocab[m[2]]){w.classList.add('has-note');lookupCount++;}w.addEventListener('click',()=>openWord(w,m[2],line,p));p.append(w,document.createTextNode(m[3]));});reader.append(p);});document.getElementById('lookupCount').textContent=lookupCount;updateProgress();applyTypography();}
  function openWord(el,word,sentence,p){document.querySelectorAll('.word.selected').forEach(w=>w.classList.remove('selected'));document.querySelectorAll('.inline-card').forEach(c=>c.remove());el.classList.add('selected');currentWord=word;currentSentence=sentence;currentParagraph=p;state.garden.lookups++;if(state.garden.lookups>=10){state.garden.lookups=0;state.garden.sun++;toast('☀️ Tra 10 từ: +1 hạt mặt trời!');}save();updateResources();const card=document.createElement('div');card.className='inline-card';card.dataset.word=word;card.innerHTML='';const top=document.createElement('div');top.className='inline-top';const main=document.createElement('div');const h=document.createElement('h3');h.textContent=word;const base=document.createElement('p');base.className='muted small';base.textContent='Đang chuẩn bị giải thích…';const meaning=document.createElement('p');meaning.className='meaning';const grammar=document.createElement('p');const example=document.createElement('p');const label1=document.createElement('span');label1.className='label';label1.textContent='📐 Ngữ pháp';const label2=document.createElement('span');label2.className='label';label2.textContent='💬 Ví dụ';const close=document.createElement('button');close.className='btn close-inline';close.textContent='Đóng';close.onclick=()=>{card.remove();el.classList.remove('selected');};main.append(h,base);top.append(main,close);card.append(top,meaning,label1,grammar,label2,example);
    const commentTitle=document.createElement('p');commentTitle.className='label';commentTitle.textContent='✍️ Ghi chú / giải thích của bạn';const comment=document.createElement('div');comment.className='comment-box';const input=document.createElement('input');input.className='field';input.placeholder='Ghi chú nghĩa, cách dùng…';input.value=state.vocab[word]?.note||'';const saveBtn=document.createElement('button');saveBtn.className='btn';saveBtn.textContent='Lưu';saveBtn.onclick=()=>{const v=state.vocab[word]||{word,meaning:meaning.textContent||''};v.note=input.value.trim();state.vocab[word]=v;save();el.classList.toggle('has-note',!!v.note);toast(v.note?'Đã lưu ghi chú ✍️':'Đã xóa ghi chú');};comment.append(input,saveBtn);card.append(commentTitle,comment);p.after(card);card.scrollIntoView({behavior:'smooth',block:'nearest'});
    const existing=state.vocab[word];if(existing?.meaning){fillCard(card,existing);return;}explainWord(word,sentence).then(data=>{if(!card.isConnected)return;fillCard(card,data);state.vocab[word]={...data,note:state.vocab[word]?.note||''};save();});
  }
  function fillCard(card,data){const ps=card.querySelectorAll('p');ps[0].textContent=data.baseForm?'Nguyên thể: '+data.baseForm:(data.pos||'Từ tiếng Hàn');ps[1].textContent=data.meaning||'Chưa có nghĩa';ps[2].textContent=data.grammar||'Chưa có giải thích ngữ pháp.';ps[3].textContent=data.example||'';}
  const quickDict={'소년':'cậu bé','소녀':'cô bé','개울':'con suối nhỏ','학교':'trường học','마을':'ngôi làng','하늘':'bầu trời','고양이':'con mèo','별':'ngôi sao','바람':'gió','사랑':'tình yêu','사람':'con người','오늘':'hôm nay','마음':'tấm lòng, tâm trạng','기다리다':'chờ đợi','보다':'nhìn, xem','가다':'đi','오다':'đến','먹다':'ăn','읽다':'đọc','웃다':'cười','울다':'khóc','예쁘다':'đẹp','작다':'nhỏ','크다':'to, lớn','물':'nước','꽃':'hoa','책':'sách','친구':'bạn bè'};
  async function explainWord(word,sentence){const apiKey=document.getElementById('apiKey').value.trim();if(apiKey){try{const res=await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key='+encodeURIComponent(apiKey),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contents:[{parts:[{text:`Giải thích từ tiếng Hàn “${word}” trong câu “${sentence}” bằng tiếng Việt. Trả về duy nhất JSON có baseForm, pos, meaning, grammar, example.`}]}],generationConfig:{responseMimeType:'application/json'}})});if(!res.ok)throw Error('API');const j=await res.json();const text=j.candidates?.[0]?.content?.parts?.[0]?.text;if(text){const d=JSON.parse(text);return{word,...d};}}catch{toast('AI chưa kết nối được; đang dùng giải thích cơ bản.');}}
    const meaning=quickDict[word]||quickDict[word.replace(/[.,!?…]+$/u,'')];return{word,baseForm:word,pos:'Từ tiếng Hàn',meaning:meaning||'Chưa có mục từ offline. Bạn có thể thêm phần giải thích vào ghi chú bên dưới hoặc nhập Gemini API key trong Cài đặt.',grammar:'Xem vị trí của từ và các tiểu từ trong câu để xác định chức năng. Câu đang đọc: '+sentence,example:'Câu gốc: '+sentence};}
  function updateProgress(){const max=document.documentElement.scrollHeight-innerHeight;const pct=max<=0?100:Math.min(100,Math.round(scrollY/max*100));document.getElementById('progressText').textContent=pct+'%';document.getElementById('progressBar').style.width=pct+'%';const s=currentStory();if(s&&pct>(s.progress||0)){s.progress=pct;save();}}
  window.addEventListener('scroll',updateProgress,{passive:true});
  function renderLibrary(){document.getElementById('storyCount').textContent=state.stories.length+' truyện';const list=document.getElementById('storyList');list.replaceChildren();state.stories.forEach(s=>{const card=document.createElement('article');card.className='story-card';const title=document.createElement('h3');title.textContent=s.title;const preview=document.createElement('p');preview.textContent=(s.content||'').slice(0,130)+'…';const meta=document.createElement('span');meta.className='muted small';meta.textContent=`${s.category||'Bài đọc'} · ${s.progress||0}%`;const actions=document.createElement('div');actions.className='row-wrap';const read=document.createElement('button');read.className='btn primary';read.textContent=s.id===state.currentId?'Đang đọc':'Đọc truyện';read.onclick=()=>{state.currentId=s.id;save();renderReader();switchTab('read');};const del=document.createElement('button');del.className='btn';del.textContent='Xóa';del.onclick=()=>deleteStory(s.id);actions.append(read);if(!s.sample)actions.append(del);card.append(title,preview,meta,actions);list.append(card);});}
  function addStory(){const title=document.getElementById('newTitle').value.trim()||`Truyện ${state.stories.length+1}`;const content=document.getElementById('newContent').value.trim();if(!content){toast('Bạn hãy nhập hoặc tải nội dung truyện trước nhé.');return;}const story={id:crypto.randomUUID?.()||String(Date.now()),title,category:'Bài đọc',content,progress:0};state.stories.unshift(story);state.currentId=story.id;save();document.getElementById('newTitle').value='';document.getElementById('newContent').value='';renderReader();switchTab('read');toast('Đã lưu truyện vào thư viện 📚');}
  document.getElementById('storyFile').addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;document.getElementById('newTitle').value=f.name.replace(/\.(txt|md)$/i,'');try{document.getElementById('newContent').value=await f.text();toast('Đã tải văn bản. Nhấn “Lưu truyện” để thêm vào thư viện.');}catch{toast('Không đọc được tệp này.');}e.target.value='';});
  function deleteStory(id){if(state.stories.length<=1){toast('Thư viện cần có ít nhất một truyện.');return;}state.stories=state.stories.filter(s=>s.id!==id);if(state.currentId===id)state.currentId=state.stories[0].id;save();renderLibrary();renderReader();toast('Đã xóa truyện.');}
  function updateResources(){document.getElementById('waterCount').textContent=state.garden.water;document.getElementById('sunCount').textContent=state.garden.sun;document.getElementById('gardenWater').textContent=state.garden.water;document.getElementById('gardenSun').textContent=state.garden.sun;}
  function renderGarden(){const g=state.garden;const i=Math.min(g.active,plants.length-1);const p=plants[i],pr=g.progress[i];document.getElementById('plantName').textContent=p.emoji+' '+p.name;document.getElementById('plantDesc').textContent=pr.done?'✨ Cây đã trưởng thành!':p.desc;document.getElementById('plantArt').textContent=pr.done?p.emoji:(pr.water||pr.sun?'🌿': '🌱');document.getElementById('waterProgress').textContent=`${pr.water} / ${p.water}`;document.getElementById('sunProgress').textContent=`${pr.sun} / 10`;document.getElementById('waterBar').style.width=Math.min(100,pr.water/p.water*100)+'%';document.getElementById('sunBar').style.width=Math.min(100,pr.sun*10)+'%';document.getElementById('feedWater').disabled=!g.water||pr.water>=p.water||pr.done;document.getElementById('feedSun').disabled=!g.sun||pr.sun>=10||pr.done;const list=document.getElementById('plantList');list.replaceChildren();plants.forEach((plant,n)=>{const prog=g.progress[n];const b=document.createElement('button');b.className='btn';b.disabled=!prog.unlocked;b.textContent=(prog.unlocked?plant.emoji:'🔒')+' '+plant.name+(prog.done?' ✓':` · 💧${plant.water}`);b.onclick=()=>{g.active=n;save();renderGarden();};list.append(b);});updateResources();}
  function feed(type){const i=state.garden.active,p=plants[i],pr=state.garden.progress[i],g=state.garden;if(type==='water'&&g.water>0&&pr.water<p.water){g.water--;pr.water++;}if(type==='sun'&&g.sun>0&&pr.sun<10){g.sun--;pr.sun++;}if(!pr.done&&pr.water>=p.water&&pr.sun>=10){pr.done=true;if(i+1<plants.length){g.progress[i+1].unlocked=true;g.active=i+1;toast(`🌱 Đã mở khóa ${plants[i+1].name}!`);}else toast('🎉 Bạn đã chăm lớn cả khu vườn!');}save();renderGarden();}
  function setTheme(theme){state.settings.theme=theme;document.body.className='theme-'+theme;save();}
  function updateTypography(){const reader=document.getElementById('reader'),font=document.getElementById('fontSelect').value,size=document.getElementById('fontSize').value,line=document.getElementById('lineHeight').value;reader.style.fontFamily=`'${font}',serif`;reader.style.fontSize=size+'px';reader.style.lineHeight=line;document.getElementById('fontSizeLabel').textContent=size+'px';document.getElementById('lineHeightLabel').textContent=Number(line).toFixed(1);state.settings.font=font;state.settings.size=Number(size);state.settings.line=Number(line);save();}
  function saveSetting(name,value){state.settings[name]=value;save();}
  function applySettings(){setTheme(state.settings.theme);document.getElementById('fontSelect').value=state.settings.font;document.getElementById('fontSize').value=state.settings.size;document.getElementById('lineHeight').value=state.settings.line;document.getElementById('quizEnabled').checked=state.settings.quiz;updateTypography();}
  document.getElementById('audioFiles').addEventListener('change',e=>{for(const f of e.target.files||[])tracks.push({name:f.name,url:URL.createObjectURL(f)});renderPlaylist();if(currentTrack<0&&tracks.length)playTrack(0);e.target.value='';});
  function renderPlaylist(){const list=document.getElementById('playlist');list.replaceChildren();document.getElementById('trackSummary').textContent=tracks.length?`${tracks.length} bài trong danh sách phát`:'Danh sách phát trống';tracks.forEach((t,i)=>{const row=document.createElement('div');row.className='track';const name=document.createElement('span');name.textContent=`${i+1}. ${t.name}`;const play=document.createElement('button');play.className='btn';play.textContent=i===currentTrack?'Đang phát':'Phát';play.onclick=()=>playTrack(i);row.append(name,play);list.append(row);});}
  function playTrack(i){if(!tracks.length)return;currentTrack=(i+tracks.length)%tracks.length;const audio=document.getElementById('audio');audio.src=tracks[currentTrack].url;audio.loop=document.getElementById('loopAudio').checked;audio.play().catch(()=>{});document.getElementById('trackName').textContent=tracks[currentTrack].name;document.getElementById('playButton').textContent='⏸ Đang phát';renderPlaylist();}
  function toggleAudio(){const a=document.getElementById('audio');if(!a.src){if(tracks.length)playTrack(0);else document.getElementById('audioFiles').click();return;}if(a.paused){a.play();document.getElementById('playButton').textContent='⏸ Đang phát';}else{a.pause();document.getElementById('playButton').textContent='▶ Tiếp tục';}}
  document.getElementById('loopAudio').addEventListener('change',e=>document.getElementById('audio').loop=e.target.checked);
  document.getElementById('audio').addEventListener('ended',()=>{if(!document.getElementById('audio').loop)playTrack(currentTrack+1);});
  function tick(){if(document.hidden)return;const g=state.garden;g.seconds++;if(g.seconds>=300){g.seconds-=300;g.water++;toast('💧 Đọc đủ 5 phút: +1 giọt nước!');showQuiz();}if(g.seconds%10===0)save();updateResources();}
  function showQuiz(){if(!state.settings.quiz)return;const entries=Object.values(state.vocab).filter(v=>v.meaning);if(!entries.length)return;const target=entries[Math.floor(Math.random()*entries.length)];const wrong=['Cảm thấy bình yên','Bước đi vội vã','Ngắm nhìn bầu trời','Chờ đợi ai đó'].filter(x=>x!==target.meaning);const opts=[target.meaning,...wrong].sort(()=>Math.random()-.5).slice(0,4);document.getElementById('quizPrompt').textContent=`Từ “${target.word}” có nghĩa là gì?`;const box=document.getElementById('quizOptions');box.replaceChildren();document.getElementById('quizFeedback').textContent='';document.getElementById('quizDone').classList.add('hidden');opts.forEach(o=>{const b=document.createElement('button');b.className='btn';b.textContent=o;b.onclick=()=>{box.querySelectorAll('button').forEach(x=>x.disabled=true);if(o===target.meaning){state.garden.sun++;document.getElementById('quizFeedback').textContent='🎉 Chính xác! Bạn nhận được 1 hạt mặt trời.';}else{state.garden.seconds=Math.max(0,state.garden.seconds-60);document.getElementById('quizFeedback').textContent=`Chưa đúng — trừ 1 phút đọc. Nghĩa là: ${target.meaning}`;}save();updateResources();document.getElementById('quizDone').classList.remove('hidden');};box.append(b);});document.getElementById('quiz').classList.remove('hidden');}
  function closeQuiz(){document.getElementById('quiz').classList.add('hidden');}
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)save();});
  load();applySettings();renderReader();renderLibrary();renderGarden();updateResources();setInterval(tick,1000);
</script>
