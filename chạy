    <div id="toastContainer" class="fixed bottom-20 right-4 z-50 space-y-2 pointer-events-none"></div>

    <script>
        // =========================================================================
        // PWA SETUP & SERVICE WORKER REGISTRATION (OFFLINE SUPPORT)
        // =========================================================================
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            document.getElementById('installPwaBtn').classList.remove('hidden');
        });

        async function installPWA() {
            if (!deferredPrompt) return;
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') {
                document.getElementById('installPwaBtn').classList.add('hidden');
            }
            deferredPrompt = null;
        }

        // Đăng ký Service Worker tối giản lưu cache chạy offline
        if ('serviceWorker' in navigator) {
            const swCode = `
                self.addEventListener('install', e => { self.skipWaiting(); });
                self.addEventListener('activate', e => { clients.claim(); });
                self.addEventListener('fetch', e => { e.respondWith(fetch(e.request).catch(() => caches.match(e.request))); });
            `;
            const blob = new Blob([swCode], { type: 'text/javascript' });
            const swUrl = URL.createObjectURL(blob);
            navigator.serviceWorker.register(swUrl).catch(() => {});
        }

        // =========================================================================
        // DỮ LIỆU & TRẠNG THÁI ỨNG DỤNG (LOCALSTORAGE)
        // =========================================================================
        const SAMPLE_STORIES = [
            {
                id: 'story-1',
                title: '소나기 — Cơn mưa rào đầu hạ (Hwang Sun-won)',
                category: 'Truyện ngắn',
                content: `소년은 개울가에서 소녀를 보자 곧 윤 초시네 증손녀딸이라는 걸 알 수 있었다. 소녀는 개울에다 손을 잠그고 물장난을 하고 있는 것이다. 서울서는 이런 개울물을 보지 못하기나 한 듯이.

벌써 며칠째 소녀는, 학교에서 돌아오는 길에 물장난이었다. 그런데 어제까지는 개울 기슭에서 하더니, 오늘은 징검다리 한가운데 앉아서 하고 있다.

소년은 개울둑에 앉아 버렸다. 소녀가 비켜서기를 기다리자는 것이다. 요행 지나가는 사람이 있어, 소녀가 길을 비켜 주었다.`,
                progress: 0
            },
            {
                id: 'story-2',
                title: '밤하늘의 별을 세는 고양이 — Mèo đếm sao đêm',
                category: 'Cổ tích',
                content: `작은 마을의 가장 높은 지붕 위에는 매일 밤 올라가는 하얀 고양이가 있었습니다. 고양이는 반짝이는 별들을 하나씩 세면서 자신의 잃어버린 기억을 찾고 있었죠.

어느 날, 바람이 부드럽게 불어오던 밤에 작은 반딧불이 한 마리가 고양이의 코끝에 앉았습니다. "너는 왜 매일 밤 하늘만 바라보니?" 반딧불이가 조심스럽게 물었습니다.`,
                progress: 0
            }
        ];

        const PLANTS_CONFIG = [
            { id: 0, name: 'Hoa Anh Thảo', emoji: '🌼', waterReq: 5, sunReq: 10, desc: 'Nở trong chiều tà, tượng trưng cho khởi đầu kiên nhẫn.', color: '#facc15' },
            { id: 1, name: 'Hoa Hồng Nhung', emoji: '🌹', waterReq: 10, sunReq: 10, desc: 'Đóa hồng rực rỡ cần chăm chút mỗi ngày.', color: '#f43f5e' },
            { id: 2, name: 'Cỏ Bốn Lá', emoji: '🍀', waterReq: 15, sunReq: 10, desc: 'Biểu tượng của sự may mắn khi chinh phục từ vựng mới.', color: '#10b981' },
            { id: 3, name: 'Cây Hoa Anh Đào', emoji: '🌸', waterReq: 20, sunReq: 10, desc: 'Tán hoa anh đào hồng phấn tung bay thơ mộng.', color: '#f472b6' },
            { id: 4, name: 'Cây Ngô Đồng', emoji: '🌳', waterReq: 25, sunReq: 10, desc: 'Loài cây cao quý trong văn hóa Á Đông.', color: '#8b5cf6' },
            { id: 5, name: 'Cổ Thụ Ánh Sao', emoji: '✨', waterReq: 30, sunReq: 10, desc: 'Cây huyền thoại kết tinh từ hàng trăm trang sách.', color: '#38bdf8' }
        ];

        const STORAGE_KEY = 'vuon_chu_pwa_state_v2';
        let appState = {
            stories: [],
            currentStoryId: null,
            vocabBank: {},
            settings: { theme: 'dark', fontFamily: 'font-krBatang', fontSize: 21, lineHeight: 2.0, quizEnabled: true },
            garden: {
                waterDrops: 1,
                sunSeeds: 1,
                readingSeconds: 0,
                lookupCounter: 0,
                activePlantIndex: 0,
                plantsProgress: PLANTS_CONFIG.map((_, i) => ({ unlocked: i === 0, waterFed: 0, sunFed: 0, completed: false }))
            }
        };

        function loadState() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    appState = { ...appState, ...parsed, settings: { ...appState.settings, ...(parsed.settings || {}) }, garden: { ...appState.garden, ...(parsed.garden || {}) } };
                }
            } catch (e) {}
            if (!appState.stories || appState.stories.length === 0) appState.stories = [...SAMPLE_STORIES];
            if (!appState.currentStoryId || !appState.stories.find(s => s.id === appState.currentStoryId)) {
                appState.currentStoryId = appState.stories[0].id;
            }
        }

        function saveState() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(appState)); } catch (e) {}
        }

        // =========================================================================
        // TAB NAVIGATION
        // =========================================================================
        let currentTab = 'read';
        function switchTab(tabId) {
            currentTab = tabId;
            ['read', 'library', 'garden', 'music', 'settings'].forEach(id => {
                document.getElementById(`view${id.charAt(0).toUpperCase() + id.slice(1)}`).classList.toggle('hidden', id !== tabId);
                const btn = document.getElementById(`navBtn-${id}`);
                if (btn) {
                    btn.className = `flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition ${id === tabId ? 'text-emerald-400 font-bold' : 'muted-text hover:text-emerald-400'}`;
                }
            });

            if (tabId === 'library') renderLibrary();
            if (tabId === 'garden') renderGarden();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // =========================================================================
        // READER & AI WORD POPUP
        // =========================================================================
        let activeWordEl = null;
        let currentWord = '', currentSentence = '';

        function getCurrentStory() {
            return appState.stories.find(s => s.id === appState.currentStoryId) || appState.stories[0];
        }

        function renderReader() {
            const story = getCurrentStory();
            if (!story) return;

            document.getElementById('headerStoryTitle').textContent = story.title;
            document.getElementById('articleMainTitle').textContent = story.title;
            document.getElementById('readCategoryBadge').textContent = story.category || 'Truyện ngắn';

            const container = document.getElementById('readerContent');
            container.innerHTML = '';
            let lookups = 0;

            story.content.split(/\n+/).forEach(para => {
                const trimmed = para.trim();
                if (!trimmed) return;
                const p = document.createElement('p');
                p.className = 'mb-6';

                trimmed.split(/(\s+)/).forEach(token => {
                    if (/^\s+$/.test(token)) {
                        p.appendChild(document.createTextNode(token));
                        return;
                    }
                    if (!/[\uAC00-\uD7A3]/.test(token)) {
                        p.appendChild(document.createTextNode(token));
                        return;
                    }

                    const match = token.match(/^([^\uAC00-\uD7A3a-zA-Z0-9]*)(.+?)([^\uAC00-\uD7A3a-zA-Z0-9]*)$/);
                    const prefix = match ? match[1] : '';
                    const core = match ? match[2] : token;
                    const suffix = match ? match[3] : '';

                    if (prefix) p.appendChild(document.createTextNode(prefix));

                    const span = document.createElement('span');
                    span.textContent = core;
                    span.className = 'kr-word';
                    span.dataset.word = core;

                    const saved = appState.vocabBank[core];
                    if (saved) {
                        span.classList.add('looked-up');
                        lookups++;
                        if (saved.note) span.classList.add('has-note');
                    }

                    span.onclick = (e) => {
                        e.stopPropagation();
                        handleWordClick(span, core, trimmed);
                    };

                    p.appendChild(span);
                    if (suffix) p.appendChild(document.createTextNode(suffix));
                });
                container.appendChild(p);
            });

            document.getElementById('storyLookupCount').textContent = lookups;
            updateScrollProgress();
        }

        function updateScrollProgress() {
            const st = window.scrollY, dh = document.documentElement.scrollHeight - window.innerHeight;
            const pct = dh <= 0 ? 100 : Math.min(100, Math.max(0, Math.round((st / dh) * 100)));
            document.getElementById('readProgressText').textContent = `${pct}%`;
            const story = getCurrentStory();
            if (story && pct > (story.progress || 0)) {
                story.progress = pct;
                saveState();
            }
        }
        window.addEventListener('scroll', updateScrollProgress, { passive: true });

        function positionPopover(el) {
            const pop = document.getElementById('wordPopover');
            pop.classList.remove('hidden');
            const rect = el.getBoundingClientRect();
            const popRect = pop.getBoundingClientRect();
            let left = rect.left + rect.width / 2 - popRect.width / 2;
            left = Math.max(10, Math.min(window.innerWidth - popRect.width - 10, left));
            let top = rect.bottom + 10;
            if (top + popRect.height > window.innerHeight) top = rect.top - popRect.height - 10;

            pop.style.left = `${left}px`;
            pop.style.top = `${Math.max(60, top)}px`;
        }

        async function handleWordClick(spanEl, word, sentence) {
            if (activeWordEl) activeWordEl.classList.remove('active-word');
            activeWordEl = spanEl;
            activeWordEl.classList.add('active-word');
            currentWord = word;
            currentSentence = sentence;

            registerLookup();

            const existing = appState.vocabBank[word];
            document.getElementById('popWord').textContent = word;
            document.getElementById('popNoteInput').value = existing?.note || '';

            if (existing && existing.meaning) {
                renderPopoverData(existing);
                positionPopover(spanEl);
                return;
            }

            document.getElementById('popBaseForm').textContent = 'Đang phân tích...';
            document.getElementById('popPos').textContent = 'AI';
            document.getElementById('popMeaning').textContent = '';
            document.getElementById('popLoading').classList.remove('hidden');
            document.getElementById('popResult').classList.add('hidden');
            positionPopover(spanEl);

            await fetchAiWord(word, sentence, spanEl);
        }

        function renderPopoverData(data) {
            document.getElementById('popLoading').classList.add('hidden');
            document.getElementById('popResult').classList.remove('hidden');
            document.getElementById('popBaseForm').textContent = data.baseForm ? `Nguyên thể: ${data.baseForm}` : '';
            document.getElementById('popPos').textContent = data.pos || 'Từ vựng';
            document.getElementById('popMeaning').textContent = data.meaning || 'Chưa rõ nghĩa';
            document.getElementById('popGrammar').textContent = data.grammar || 'Không có cấu trúc phức tạp.';
            document.getElementById('popExample').textContent = data.example || '';
        }

        async function retryAiExplanation() {
            if (!currentWord || !activeWordEl) return;
            document.getElementById('popLoading').classList.remove('hidden');
            document.getElementById('popResult').classList.add('hidden');
            await fetchAiWord(currentWord, currentSentence, activeWordEl);
        }

        async function fetchAiWord(word, sentence, spanEl) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            const prompt = `Từ: "${word}"\nCâu: "${sentence}"\nGiải thích tiếng Việt, dạng nguyên thể, từ loại, ngữ pháp tiểu từ và 1 câu ví dụ. JSON schema: baseForm, pos, meaning, grammar, example.`;

            try {
                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        contents: [{parts: [{text: prompt}]}],
                        systemInstruction: {parts: [{text: "Bạn là giáo viên tiếng Hàn. Trả về JSON chuẩn tiếng Việt."}]},
                        generationConfig: {
                            responseMimeType: "application/json",
                            responseSchema: {
                                type: "OBJECT",
                                properties: {
                                    baseForm: {type: "STRING"}, pos: {type: "STRING"},
                                    meaning: {type: "STRING"}, grammar: {type: "STRING"}, example: {type: "STRING"}
                                },
                                required: ["baseForm", "pos", "meaning", "grammar", "example"]
                            }
                        }
                    })
                });
                const data = await res.json();
                const parsed = JSON.parse(data.candidates[0].content.parts[0].text);
                appState.vocabBank[word] = { word, ...parsed, note: appState.vocabBank[word]?.note || '' };
                saveState();

                document.querySelectorAll(`.kr-word[data-word="${CSS.escape(word)}"]`).forEach(el => el.classList.add('looked-up'));
                renderPopoverData(appState.vocabBank[word]);
                positionPopover(spanEl);
            } catch (e) {
                const fallback = { word, baseForm: word, pos: 'Từ vựng', meaning: 'Lỗi kết nối AI - Vui lòng thử lại', grammar: '', example: '', note: '' };
                renderPopoverData(fallback);
                positionPopover(spanEl);
            }
        }

        function saveWordNote() {
            if (!currentWord) return;
            const note = document.getElementById('popNoteInput').value.trim();
            if (!appState.vocabBank[currentWord]) appState.vocabBank[currentWord] = { word: currentWord, meaning: '' };
            appState.vocabBank[currentWord].note = note;
            saveState();

            document.querySelectorAll(`.kr-word[data-word="${CSS.escape(currentWord)}"]`).forEach(el => {
                el.classList.add('looked-up');
                if (note) el.classList.add('has-note'); else el.classList.remove('has-note');
            });
            showToast(note ? 'Đã lưu ghi chú ✍️' : 'Đã xóa ghi chú');
        }

        function closePopover() {
            document.getElementById('wordPopover').classList.add('hidden');
            if (activeWordEl) { activeWordEl.classList.remove('active-word'); activeWordEl = null; }
        }

        document.addEventListener('click', (e) => {
            const pop = document.getElementById('wordPopover');
            if (!pop.classList.contains('hidden') && !pop.contains(e.target)) closePopover();
        });

        // =========================================================================
        // TIMERS, WATER, SUN & QUIZ
        // =========================================================================
        function updateUIResources() {
            document.getElementById('waterCount').textContent = appState.garden.waterDrops;
            document.getElementById('sunCount').textContent = appState.garden.sunSeeds;
            document.getElementById('gardenWaterCount').textContent = appState.garden.waterDrops;
            document.getElementById('gardenSunCount').textContent = appState.garden.sunSeeds;
            const dot = document.getElementById('navGardenDot');
            if (appState.garden.waterDrops > 0 || appState.garden.sunSeeds > 0) dot.classList.remove('hidden');
            else dot.classList.add('hidden');
        }

        function registerLookup() {
            appState.garden.lookupCounter++;
            if (appState.garden.lookupCounter >= 10) {
                appState.garden.lookupCounter = 0;
                appState.garden.sunSeeds++;
                showToast('☀️ Tra 10 từ: +1 Hạt mặt trời!');
            }
            saveState();
            updateUIResources();
        }

        // Đếm thời gian đọc 5 phút
        setInterval(() => {
            if (document.hidden) return;
            appState.garden.readingSeconds++;
            if (appState.garden.readingSeconds >= 300) {
                appState.garden.readingSeconds = 0;
                appState.garden.waterDrops++;
                showToast('💧 Đọc đủ 5 phút! +1 Giọt nước!');
                triggerQuiz();
            }
            if (appState.garden.readingSeconds % 10 === 0) saveState();
            updateUIResources();
        }, 1000);

        function triggerQuiz() {
            if (!appState.settings.quizEnabled) return;
            const entries = Object.values(appState.vocabBank).filter(v => v.meaning);
            if (entries.length === 0) return;
            const target = entries[Math.floor(Math.random() * entries.length)];
            const pool = ['Cảm thấy bình yên', 'Bước đi vội vã', 'Ngắm nhìn bầu trời', 'Chờ đợi ai đó'];
            const opts = [target.meaning, ...pool.filter(m => m !== target.meaning)].sort(() => 0.5 - Math.random()).slice(0, 4);

            document.getElementById('quizWordDisplay').textContent = target.word;
            const container = document.getElementById('quizOptionsContainer');
            container.innerHTML = '';
            const feedback = document.getElementById('quizFeedback');
            feedback.classList.add('hidden');
            document.getElementById('quizContinueBtn').classList.add('hidden');

            opts.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-3 rounded-xl elevated-bg border subtle-border text-xs font-medium hover:border-emerald-500 transition';
                btn.textContent = opt;
                btn.onclick = () => {
                    Array.from(container.children).forEach(b => b.disabled = true);
                    if (opt === target.meaning) {
                        btn.classList.add('border-emerald-500', 'bg-emerald-500/20', 'text-emerald-300');
                        appState.garden.sunSeeds++;
                        feedback.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-500/20 text-emerald-300';
                        feedback.textContent = '🎉 Chính xác! +1 ☀️';
                    } else {
                        btn.classList.add('border-rose-500', 'bg-rose-500/20', 'text-rose-300');
                        appState.garden.readingSeconds = Math.max(0, appState.garden.readingSeconds - 60);
                        feedback.className = 'p-3 rounded-xl text-xs font-medium bg-rose-500/20 text-rose-300';
                        feedback.textContent = `❌ Sai (-1 phút). Nghĩa: "${target.meaning}"`;
                    }
                    feedback.classList.remove('hidden');
                    document.getElementById('quizContinueBtn').classList.remove('hidden');
                    saveState();
                    updateUIResources();
                };
                container.appendChild(btn);
            });
            document.getElementById('quizModal').classList.remove('hidden');
        }

        // =========================================================================
        // GARDEN & 6 PLANTS
        // =========================================================================
        function getPlantSvg(config, stage) {
            const c = config.color;
            if (stage === 1) return `<svg viewBox="0 0 120 120" class="w-32 h-32"><ellipse cx="60" cy="95" rx="30" ry="8" fill="#5c4033"/><path d="M35 95 L42 115 L78 115 L85 95 Z" fill="#9a5b3c"/><circle cx="60" cy="91" r="6" fill="${c}"/></svg>`;
            if (stage === 2) return `<svg viewBox="0 0 120 120" class="w-32 h-32"><path d="M35 95 L42 115 L78 115 L85 95 Z" fill="#9a5b3c"/><path d="M60 95 L60 65" stroke="#10b981" stroke-width="4" stroke-linecap="round"/><path d="M60 75 Q45 65 44 75 Q52 82 60 75" fill="#34d399"/><path d="M60 70 Q75 60 76 70 Q68 78 60 70" fill="#34d399"/></svg>`;
            if (stage === 3) return `<svg viewBox="0 0 120 120" class="w-32 h-32"><path d="M35 95 L42 115 L78 115 L85 95 Z" fill="#9a5b3c"/><path d="M60 95 Q57 68 60 42" stroke="#059669" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M59 78 Q38 68 36 78 Q48 85 59 78" fill="#10b981"/><path d="M60 65 Q82 55 84 65 Q72 72 60 65" fill="#10b981"/><circle cx="60" cy="38" r="7" fill="${c}"/></svg>`;
            return `<svg viewBox="0 0 120 120" class="w-32 h-32"><path d="M35 95 L42 115 L78 115 L85 95 Z" fill="#9a5b3c"/><path d="M60 95 Q57 64 60 35" stroke="#059669" stroke-width="5" fill="none" stroke-linecap="round"/><circle cx="60" cy="22" r="10" fill="${c}"/><circle cx="72" cy="32" r="9" fill="${c}"/><circle cx="48" cy="32" r="9" fill="${c}"/><circle cx="60" cy="33" r="6" fill="#fef08a"/></svg>`;
        }

        function renderGarden() {
            const idx = appState.garden.activePlantIndex;
            const plant = PLANTS_CONFIG[idx];
            const prog = appState.garden.plantsProgress[idx];
            const stage = prog.completed ? 4 : (prog.waterFed > 0 || prog.sunFed > 0 ? 3 : 1);

            document.getElementById('activePlantOrder').textContent = `Cây #${idx + 1} / 6`;
            document.getElementById('activePlantName', '').textContent = `${plant.emoji} ${plant.name}`;
            document.getElementById('activePlantDesc').textContent = plant.desc;
            document.getElementById('plantStageBadge').textContent = prog.completed ? '✨ Trưởng thành' : `Giai đoạn ${stage}/4`;
            document.getElementById('plantIllustration').innerHTML = getPlantSvg(plant, stage);
            document.getElementById('plantStatusCaption').textContent = prog.completed ? 'Cây đã nở rực rỡ!' : 'Đang phát triển từng ngày...';

            document.getElementById('plantWaterText').textContent = `${prog.waterFed} / ${plant.waterReq}`;
            document.getElementById('plantWaterBar').style.width = `${Math.min(100, (prog.waterFed / plant.waterReq) * 100)}%`;
            document.getElementById('plantSunText').textContent = `${prog.sunFed} / ${plant.sunReq}`;
            document.getElementById('plantSunBar').style.width = `${Math.min(100, (prog.sunFed / plant.sunReq) * 100)}%`;

            document.getElementById('availWater').textContent = appState.garden.waterDrops;
            document.getElementById('availSun').textContent = appState.garden.sunSeeds;
            document.getElementById('btnWater').disabled = appState.garden.waterDrops <= 0 || prog.waterFed >= plant.waterReq;
            document.getElementById('btnSun').disabled = appState.garden.sunSeeds <= 0 || prog.sunFed >= plant.sunReq;

            const grid = document.getElementById('plantCollectionGrid');
            grid.innerHTML = '';
            PLANTS_CONFIG.forEach((p, i) => {
                const pProg = appState.garden.plantsProgress[i];
                const isCur = i === idx;
                const card = document.createElement('button');
                card.disabled = !pProg.unlocked;
                card.onclick = () => { appState.garden.activePlantIndex = i; saveState(); renderGarden(); };
                card.className = `p-3 rounded-2xl border text-left transition ${isCur ? 'border-emerald-500 bg-emerald-500/15' : pProg.unlocked ? 'elevated-bg subtle-border' : 'surface-bg opacity-40 cursor-not-allowed'}`;
                card.innerHTML = `<div class="flex justify-between items-center mb-1"><span class="text-xl">${pProg.unlocked ? p.emoji : '🔒'}</span><span class="text-[10px]">${pProg.completed ? '✨' : ''}</span></div><p class="text-xs font-bold truncate">${pProg.unlocked ? p.name : `Khóa #${i+1}`}</p>`;
                grid.appendChild(card);
            });
            updateUIResources();
        }

        function feedPlant(type) {
            const idx = appState.garden.activePlantIndex;
            const plant = PLANTS_CONFIG[idx];
            const prog = appState.garden.plantsProgress[idx];

            if (type === 'water' && appState.garden.waterDrops > 0 && prog.waterFed < plant.waterReq) {
                appState.garden.waterDrops--; prog.waterFed++;
            } else if (type === 'sun' && appState.garden.sunSeeds > 0 && prog.sunFed < plant.sunReq) {
                appState.garden.sunSeeds--; prog.sunFed++;
            }

            if (!prog.completed && prog.waterFed >= plant.waterReq && prog.sunFed >= plant.sunReq) {
                prog.completed = true;
                showToast(`🎊 ${plant.name} đã nở hoa!`);
                if (idx + 1 < PLANTS_CONFIG.length) {
                    appState.garden.plantsProgress[idx + 1].unlocked = true;
                    appState.garden.activePlantIndex = idx + 1;
                    showToast(`🌱 Đã mở khóa cây mới: ${PLANTS_CONFIG[idx + 1].name}!`);
                }
            }
            saveState();
            renderGarden();
        }

        // =========================================================================
        // LIBRARY & MUSIC PLAYER
        // =========================================================================
        function renderLibrary() {
            const container = document.getElementById('storyListContainer');
            document.getElementById('libraryStoryCount').textContent = appState.stories.length;
            container.innerHTML = '';

            appState.stories.forEach(story => {
                const isCur = story.id === appState.currentStoryId;
                const card = document.createElement('div');
                card.className = `p-4 rounded-2xl border flex flex-col justify-between gap-3 ${isCur ? 'border-emerald-500 bg-emerald-500/10' : 'elevated-bg subtle-border'}`;
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between"><h4 class="text-sm font-bold truncate">${story.title}</h4>${isCur ? '<span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500 text-white font-semibold">Đang đọc</span>' : ''}</div>
                        <p class="text-xs muted-text line-clamp-2 mt-1 font-krSans">${story.content.slice(0, 80)}...</p>
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t subtle-border text-xs">
                        <span class="muted-text">Tiến độ: <strong class="text-emerald-400">${story.progress || 0}%</strong></span>
                        <div class="flex gap-1.5">
                            <button onclick="selectStory('${story.id}')" class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold">Đọc</button>
                            ${appState.stories.length > 1 ? `<button onclick="deleteStory('${story.id}')" class="p-1 hover:text-rose-400">🗑️</button>` : ''}
                        </div>
                    </div>`;
                container.appendChild(card);
            });
        }

        function selectStory(id) {
            appState.currentStoryId = id;
            saveState();
            renderReader();
            switchTab('read');
        }

        function deleteStory(id) {
            appState.stories = appState.stories.filter(s => s.id !== id);
            if (appState.currentStoryId === id && appState.stories.length > 0) appState.currentStoryId = appState.stories[0].id;
            saveState();
            renderLibrary();
            renderReader();
            showToast('Đã xóa truyện');
        }

        function addNewStory() {
            const title = document.getElementById('newStoryTitle').value.trim() || `Truyện #${appState.stories.length + 1}`;
            const content = document.getElementById('newStoryContent').value.trim();
            if (!content) { showToast('Vui lòng nhập nội dung!'); return; }

            const newS = { id: 'story-' + Date.now(), title, category: 'Tự thêm', content, progress: 0 };
            appState.stories.unshift(newS);
            appState.currentStoryId = newS.id;
            saveState();
            document.getElementById('newStoryTitle').value = '';
            document.getElementById('newStoryContent').value = '';
            renderReader();
            switchTab('read');
            showToast('✨ Đã thêm truyện mới!');
        }

        function handleStoryFile(e) {
            const file = e.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (evt) => {
                document.getElementById('newStoryContent').value = evt.target.result;
                document.getElementById('newStoryTitle').value = file.name.replace(/\.[^/.]+$/, '');
                showToast(`Đã tải file "${file.name}"`);
            };
            reader.readAsText(file, 'UTF-8');
        }

        // Trình phát nhạc
        let playlist = [], currentTrack = 0;
        const audio = document.getElementById('bgAudioPlayer');

        function handleAudioFiles(e) {
            const files = Array.from(e.target.files || []);
            files.forEach(f => playlist.push({ name: f.name.replace(/\.[^/.]+$/, ''), url: URL.createObjectURL(f) }));
            renderPlaylist();
            if (audio.paused && playlist.length === files.length) playTrack(0);
            showToast(`Đã thêm ${files.length} bài nhạc`);
        }

        function playTrack(idx) {
            if (playlist.length === 0) return;
            currentTrack = (idx + playlist.length) % playlist.length;
            const t = playlist[currentTrack];
            audio.src = t.url;
            audio.play();
            document.getElementById('currentTrackDisplay').textContent = `🎵 ${t.name}`;
            document.getElementById('mainPlayBtn').textContent = '⏸';
            renderPlaylist();
        }

        function togglePlayPause() {
            if (playlist.length === 0) { document.getElementById('audioFileInput').click(); return; }
            if (audio.paused) { audio.play(); document.getElementById('mainPlayBtn').textContent = '⏸'; }
            else { audio.pause(); document.getElementById('mainPlayBtn').textContent = '▶'; }
        }

        function nextTrack() { playTrack(currentTrack + 1); }
        function prevTrack() { playTrack(currentTrack - 1); }
        function toggleLoop() { audio.loop = !audio.loop; document.getElementById('loopBtn').classList.toggle('opacity-100', audio.loop); }
        function seekAudio(val) { audio.currentTime = (val / 100) * audio.duration; }

        audio.addEventListener('timeupdate', () => {
            if (audio.duration) {
                document.getElementById('audioSeekBar').value = (audio.currentTime / audio.duration) * 100;
                document.getElementById('audioCurrentTime').textContent = formatTime(audio.currentTime);
                document.getElementById('audioDuration').textContent = formatTime(audio.duration);
            }
        });
        audio.addEventListener('ended', nextTrack);

        function formatTime(sec) {
            const m = Math.floor(sec / 60), s = Math.floor(sec % 60);
            return `${m}:${s.toString().padStart(2, '0')}`;
        }

        function renderPlaylist() {
            const c = document.getElementById('playlistContainer');
            document.getElementById('playlistInfo').textContent = `${playlist.length} bài hát`;
            c.innerHTML = '';
            playlist.forEach((t, i) => {
                const item = document.createElement('div');
                item.className = `p-2.5 rounded-xl flex items-center justify-between text-xs ${i === currentTrack ? 'bg-pink-500/20 text-pink-400 font-bold' : 'elevated-bg'}`;
                item.innerHTML = `<span>${t.name}</span><button onclick="playTrack(${i})" class="px-2 py-1 rounded bg-pink-600 text-white">Phát</button>`;
                c.appendChild(item);
            });
        }

        // =========================================================================
        // SETTINGS & TOAST
        // =========================================================================
        function setReaderTheme(theme) {
            appState.settings.theme = theme;
            document.body.className = `theme-${theme} app-bg min-h-screen flex flex-col selection:bg-emerald-500/30 pb-20 sm:pb-0`;
            saveState();
        }

        function updateTypography() {
            const font = document.getElementById('fontSelect').value;
            const size = document.getElementById('fontSizeRange').value;
            const line = document.getElementById('lineHeightRange').value;
            appState.settings = { ...appState.settings, fontFamily: font, fontSize: Number(size), lineHeight: Number(line) };
            document.getElementById('fontSizeVal').textContent = `${size}px`;
            document.getElementById('lineHeightVal').textContent = line;

            const reader = document.getElementById('readerContent');
            reader.className = `${font} select-text break-keep pb-12 transition-all`;
            reader.style.fontSize = `${size}px`;
            reader.style.lineHeight = line;
            saveState();
        }

        function toggleQuizSetting(val) {
            appState.settings.quizEnabled = val;
            saveState();
            showToast(val ? 'Đã bật kiểm tra 5 phút' : 'Đã tắt kiểm tra 5 phút');
        }

        function applySettings() {
            setReaderTheme(appState.settings.theme);
            document.getElementById('fontSelect').value = appState.settings.fontFamily;
            document.getElementById('fontSizeRange').value = appState.settings.fontSize;
            document.getElementById('lineHeightRange').value = appState.settings.lineHeight;
            document.getElementById('quizToggle').checked = appState.settings.quizEnabled;
            updateTypography();
        }

        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        function showToast(msg) {
            const container = document.getElementById('toastContainer');
            const t = document.createElement('div');
            t.className = 'surface-bg border subtle-border px-4 py-2.5 rounded-2xl shadow-xl text-xs font-medium';
            t.textContent = msg;
            container.appendChild(t);
            setTimeout(() => t.remove(), 3200);
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            applySettings();
            renderReader();
            updateUIResources();
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
